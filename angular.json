{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "process-mapping-solution": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "pms",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/process-mapping-solution",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "duckdb-*.wasm",
                "input": "node_modules/@duckdb/duckdb-wasm/dist",
                "output": "duckdb"
              },
              {
                "glob": "duckdb-browser-*.worker.js",
                "input": "node_modules/@duckdb/duckdb-wasm/dist",
                "output": "duckdb"
              }
            ],
            "styles": ["src/styles.css"],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "2mb", "maximumError": "5mb" },
                  { "type": "anyComponentStyle", "maximumWarning": "30kb", "maximumError": "36kb" }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": { "buildTarget": "process-mapping-solution:build:production" },
            "development": { "buildTarget": "process-mapping-solution:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": { "analytics": false }
}
